/* Textual CSS theme for audio extraction TUI */

/* Global styles */
Screen {
    background: $surface;
}

/* Header and Footer - use $panel for subtle theme-aware header */
Header {
    background: $panel;
    color: $text;
    text-style: bold;
}

Footer {
    background: $panel;
}

/* Containers and panels */
Container {
    background: $surface;
}

Panel {
    border: solid $accent;
    background: $panel;
}

/* Progress and status */
.progress-card {
    border: solid $accent;
    padding: 1;
    margin: 1;
    background: $panel;
}

.progress-complete {
    border: solid $success;
}

.progress-error {
    border: solid $error;
}

/* Log entries */
.log-entry {
    color: $text-disabled;
}

.log-info {
    color: $text;
}

.log-warning {
    color: $warning;
}

.log-error {
    color: $error;
    text-style: bold;
}

/* Buttons */
Button {
    margin: 0 1;
}

Button:focus {
    text-style: bold;
}

/* Tables */
DataTable {
    height: 100%;
}

DataTable > .datatable--header {
    text-style: bold;
    background: $primary;
}

DataTable > .datatable--cursor {
    background: $accent;
}

/* Input fields */
Input {
    border: solid $primary;
}

Input:focus {
    border: solid $accent;
}

/* Select widgets */
Select {
    border: solid $primary;
}

Select:focus {
    border: solid $accent;
}

/* Tree widgets */
Tree {
    background: $surface;
}

TreeNode:hover {
    background: $panel;
}

TreeNode.-selected {
    background: $accent;
}

/* Labels */
Label {
    color: $text;
}

.title {
    text-style: bold;
    text-align: center;
    color: $accent;
}

.subtitle {
    text-style: italic;
    color: $text-disabled;
}

/* Status indicators */
.status-ok {
    color: $success;
}

.status-warning {
    color: $warning;
}

.status-error {
    color: $error;
}

/* Artifacts table */
.artifact-row {
    color: $text;
}

.artifact-row:hover {
    background: $panel;
}

/* Health check panel */
.health-ok {
    color: $success;
}

.health-error {
    color: $error;
}

.health-unknown {
    color: $text-disabled;
}

/* ========================================
   Pipeline Timeline Styles
   ======================================== */

PipelineTimeline {
    transition: background 200ms;
}

/* Timeline node states */
TimelineNode {
    transition: color 200ms, background 200ms;
}

TimelineNode.running .node-indicator {
    text-style: bold;
}

TimelineNode.complete .node-indicator {
    text-style: bold;
}

/* Flash animation for fast completions */
TimelineNode.flash-complete {
    background: $success-darken-2;
}

/* Timeline connector animations */
TimelineConnector {
    transition: background 300ms;
}

/* ========================================
   Focus Card Styles
   ======================================== */

FocusCard {
    transition: border 300ms, opacity 300ms, background 200ms;
}

FocusCard.idle {
    opacity: 0.7;
}

FocusCard .stage-icon {
    color: $accent;
}

FocusCard.complete .stage-icon {
    color: $success;
}

FocusCard.error .stage-icon {
    color: $error;
}

FocusCard ProgressBar {
    width: 100%;
}

FocusCard ProgressBar > .bar--bar {
    color: $accent;
}

FocusCard ProgressBar > .bar--complete {
    color: $success;
}

FocusCard Sparkline {
    width: 100%;
}

FocusCard Sparkline > .sparkline--max-color {
    color: $accent;
}

FocusCard Sparkline > .sparkline--min-color {
    color: $primary;
}

/* ========================================
   Completed Summary Styles
   ======================================== */

CompletedSummary {
    transition: background 200ms;
}

CompletedSummary.flash-complete {
    background: $success-darken-3;
}

/* ========================================
   Legacy Progress Card Styles (deprecated)
   ======================================== */

ProgressCard {
    transition: border 300ms;
}

ProgressCard Digits {
    color: $accent;
    text-align: center;
}

ProgressCard.complete Digits {
    color: $success;
}

ProgressCard.error Digits {
    color: $error;
}

ProgressCard LoadingIndicator {
    color: $accent;
}

ProgressCard Sparkline {
    width: 100%;
}

ProgressCard Sparkline > .sparkline--max-color {
    color: $accent;
}

ProgressCard Sparkline > .sparkline--min-color {
    color: $primary;
}

/* ========================================
   Button Animations
   ======================================== */

Button {
    transition: background 200ms, opacity 200ms;
}

Button:disabled {
    opacity: 0.5;
}

Button.-success {
    background: $success;
}

Button.-error {
    background: $error;
}

